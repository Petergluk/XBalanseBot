# XBalanseBot - Production Environment Template
# ⚠️ WARNING: This is a TEMPLATE. Do NOT commit real secrets!
# Copy this file to .env.prod and fill in your actual values.
# Keep .env.prod out of version control (.gitignore includes it).

# ===========================================
# Telegram Bot Configuration
# ===========================================

# Bot token from @BotFather (https://t.me/BotFather)
BOT_TOKEN=your_bot_token_here

# Telegram Group ID (use @getmyid_bot to find your group ID)
MAIN_GROUP_ID=-1001234567890

# Your Telegram User ID (use @userinfobot to find your ID)
SUPER_ADMIN_ID=123456789

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================

# Option 1: Use DATABASE_URL (recommended)
DATABASE_URL=postgresql://user:password@host:port/database

# Option 2: Individual connection parameters
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=xbalansebot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# ===========================================
# Redis Configuration
# ===========================================

# Option 1: Use REDIS_URL (recommended)
REDIS_URL=rediss://user:password@host:port

# Option 2: Individual connection parameters
REDIS_HOST=localhost

# ===========================================
# Webhook Configuration (Production Only)
# ===========================================

# Your public domain (e.g., your-app.koyeb.app, your-app.onrender.com)
WEBHOOK_HOST=your-domain.com

# Secret token for Telegram webhook verification (generate: openssl rand -hex 32)
WEBHOOK_SECRET_TOKEN=your_telegram_secret_token_here

# Secret token for Tribute webhook verification
TRIBUTE_WEBHOOK_SECRET=your_tribute_secret_here

# ===========================================
# Bot Configuration
# ===========================================

# Development mode: True = polling, False = webhook
DEV_MODE=False

# ===========================================
# How to Generate Secure Secrets
# ===========================================

# OpenSSL:
#   openssl rand -hex 32
#
# Python:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ===========================================
# Security Reminders
# ===========================================

# 1. NEVER commit this file with real values
# 2. Use platform secrets management (Koyeb Secrets, Render Env Vars)
# 3. Rotate secrets regularly (every 90 days recommended)
# 4. Use different secrets for dev/staging/production
# 5. Backup your database before major changes